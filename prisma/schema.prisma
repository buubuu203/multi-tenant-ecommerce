// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Tenant foundation -------------------------------------------------
// Scope: Tenant, Domain, Branding only. Commerce entities (Product, Order,
// Customer, etc.) are intentionally not modeled yet.

enum TenantStatus {
  pending
  active
  suspended
  archived
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  domains         Domain[]
  branding        Branding?
  products        Product[]
  variantOptions  VariantOption[]
  locations       Location[]
  orders          Order[]
  customers       Customer[]
  payments        Payment[]
  productMedia    ProductMedia[]
  paymentMethods  TenantPaymentMethod[]
  shippingMethods TenantShippingMethod[]

  @@map("tenants")
}

enum DomainType {
  subdomain
  custom
}

// NOTE: "at most one isPrimary per tenant" IS enforced at the database
// level, via a partial unique index (domains_one_primary_per_tenant,
// added in 20260824150052_init_tenant_foundation/migration.sql) — it does
// not appear below because this Prisma version has no declarative syntax
// for partial/filtered unique indexes, so it exists only as raw SQL in
// the migration file. Don't assume "not visible in this model block"
// means "not enforced" — check the migration before concluding a
// same-shape invariant elsewhere (e.g. TenantShippingMethod.isDefault)
// needs its own new mechanism rather than this same proven one.
model Domain {
  id        String     @id @default(uuid())
  tenantId  String
  hostname  String     @unique
  type      DomainType
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("domains")
}

model Branding {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  storeName         String?
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String?
  secondaryColor    String?
  // Manual bank transfer details the merchant configures themselves —
  // displayed to a customer at checkout/order-confirmation time whenever
  // they chose paymentMethod = "bank_transfer" (see checkout-actions.ts,
  // order-queries.ts). No gateway integration: this is plain instructional
  // text, never verified/reconciled against any actual transfer.
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("branding")
}

// --- Product / Variant / Inventory foundation (Checkpoint 4F, architecture v4.1) ---
//
// Product = catalog-level identity (name, status).
// ProductVariant = the sellable unit (price, sku, status). Every Product has
// >=1 ProductVariant; a simple product gets one invisible default variant
// with combinationKey = "".
// Inventory = operational stock, separate from ProductVariant, keyed by
// (tenant, location, variant). Location is tenant-scoped; V1 uses exactly
// one default location per tenant (DB-enforced), no warehouse UI yet.
// VariantOption / VariantOptionValue form a tenant-global, reusable option
// catalog (e.g. "Color" -> "White"/"Black"), never hard-coded schema fields.
// ProductOption declares which options a given Product supports — a real
// domain-integrity table, DB-enforced against ProductVariantOptionValue,
// not just a UI hint.
// ProductVariantOptionValue is the join recording which option-values a
// variant actually has. combinationKey on ProductVariant is a derived,
// trigger-maintained cache (see the recompute_product_variant_combination_key
// function + trg_recompute_combination_key trigger, defined in raw SQL in
// the migration — Prisma has no representation for triggers) used only to
// enforce "no duplicate option combination per product" via a unique
// index; the join rows themselves remain the actual source of truth, never
// the application's own computation.
//
// Every tenant-owned table here carries a denormalized tenantId and is
// wired into composite foreign keys against its immediate parent's
// (id, tenantId) pair, so a row's tenantId can never drift from its
// parent's — enforced by Postgres, not application code. See Notion
// (Development Log, Checkpoint 4F) for the full decision record, including
// why each of these choices was made and what remains explicitly out of
// scope (warehouse UI, InventoryReservation, InventoryMovement, stock
// decrement logic, OrderItem snapshotting, multi-variant admin UI,
// speculative catalog fields, multi-currency).

enum ProductStatus {
  draft
  active
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  // Step 43: optional plain-text description — no Markdown, no HTML, no
  // rich text, rendered as-is. null means "no description set" (never an
  // empty string — see product-mutations.ts's validateDescription()).
  description String?
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  options  ProductOption[]
  // Step 50: replaces the old single Product.imageUrl field (Step 44) —
  // one product can now have many media items (images and/or videos),
  // ordered by sortOrder. imageUrl is dropped entirely by this migration,
  // not kept alongside media, to avoid two competing sources of truth for
  // "the product's picture."
  media    ProductMedia[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("products")
}

enum ProductMediaType {
  image
  video
}

// Step 50: uploaded via Vercel Blob (see product-media-mutations.ts) — url
// is the public Blob URL returned at upload time, never a client-supplied
// arbitrary string (unlike the old imageUrl field, which trusted a
// merchant-pasted link; this is now our own storage). sortOrder = 0 is the
// primary/first media item, used anywhere the app previously read
// Product.imageUrl (storefront cards, detail hero, cart, order views).
model ProductMedia {
  id        String           @id @default(uuid())
  tenantId  String
  productId String
  type      ProductMediaType
  url       String
  sortOrder Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("product_media")
}

enum ProductVariantStatus {
  active
  archived
}

model ProductVariant {
  id             String               @id @default(uuid())
  tenantId       String
  productId      String
  sku            String?
  price          Int // whole VND, no subunits — V1 market is Vietnam-only, no currency field yet
  status         ProductVariantStatus @default(active)
  combinationKey String // trigger-maintained only — see recompute_product_variant_combination_key() in the migration; never written by application code except the initial "" for a zero-option (simple product) variant
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  product               Product                     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  optionValues          ProductVariantOptionValue[] @relation("PVOV_VariantTenantCheck")
  optionValuesByProduct ProductVariantOptionValue[] @relation("PVOV_VariantProductCheck")
  inventory             Inventory[]
  orderItems            OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, productId, combinationKey])
  @@unique([id, tenantId])
  @@unique([id, productId])
  @@index([productId])
  @@map("product_variants")
}

model VariantOption {
  id       String @id @default(uuid())
  tenantId String
  name     String // a value ("Color", "Size"), never a schema field

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values         VariantOptionValue[]
  productOptions ProductOption[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("variant_options")
}

model VariantOptionValue {
  id              String @id @default(uuid())
  tenantId        String
  variantOptionId String
  value           String // a value ("White", "36"), never a schema field

  variantOption      VariantOption               @relation(fields: [variantOptionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variantLinksTenant ProductVariantOptionValue[] @relation("PVOV_TenantCheck")
  variantLinksOption ProductVariantOptionValue[] @relation("PVOV_OptionCheck")

  @@unique([tenantId, variantOptionId, value])
  @@unique([id, tenantId])
  @@unique([id, variantOptionId])
  @@map("variant_option_values")
}

model ProductOption {
  id              String @id @default(uuid())
  tenantId        String
  productId       String
  variantOptionId String

  product       Product                     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variantOption VariantOption               @relation(fields: [variantOptionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variantLinks  ProductVariantOptionValue[]

  @@unique([productId, variantOptionId])
  @@index([tenantId])
  @@map("product_options")
}

model ProductVariantOptionValue {
  id                   String @id @default(uuid())
  tenantId             String
  productId            String // denormalized from the variant's real product — enables the ProductOption consistency FK below
  productVariantId     String
  variantOptionId      String
  variantOptionValueId String

  productVariant           ProductVariant     @relation("PVOV_VariantTenantCheck", fields: [productVariantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productVariantProduct    ProductVariant     @relation("PVOV_VariantProductCheck", fields: [productVariantId, productId], references: [id, productId], onDelete: Cascade)
  productOption            ProductOption      @relation(fields: [productId, variantOptionId], references: [productId, variantOptionId], onDelete: Cascade)
  variantOptionValueTenant VariantOptionValue @relation("PVOV_TenantCheck", fields: [variantOptionValueId, tenantId], references: [id, tenantId], onDelete: Cascade)
  variantOptionValueOption VariantOptionValue @relation("PVOV_OptionCheck", fields: [variantOptionValueId, variantOptionId], references: [id, variantOptionId], onDelete: Cascade)

  @@unique([productVariantId, variantOptionId])
  @@index([tenantId])
  @@index([variantOptionValueId])
  @@map("product_variant_option_values")
}

// Exactly one Location per tenant may have isDefault = true. Prisma's
// schema DSL cannot express a partial unique constraint, so this is not
// representable as an @@unique here — it is enforced in the database only
// via a hand-written partial unique index:
//   UNIQUE (tenantId) WHERE isDefault = true
// This index MUST be included in the hand-written migration for this
// model; it will not be generated by Prisma's schema diffing.
model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("locations")
}

model Inventory {
  id               String   @id @default(uuid())
  tenantId         String
  productVariantId String
  locationId       String
  onHand           Int      @default(0)
  reserved         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  location       Location       @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, locationId, productVariantId])
  @@map("inventory")
}

// --- Order foundation (Checkpoint 4G, Step 28) --------------------------
//
// Minimum order-creation model only — no payment, no shipping, no
// fulfillment lifecycle yet (see Step 29+). Order carries no stored total —
// always derivable from its OrderItem rows (price * quantity, summed),
// avoiding a second, independently-mutable copy of data the items already
// hold.
//
// OrderItem.price is a SNAPSHOT of ProductVariant.price at order-creation
// time, copied once and never updated afterward — a later price change on
// the variant must never alter a historical order's price. OrderItem
// references ProductVariant directly (never Product, never a client-side
// option selection) via a composite FK with onDelete: Restrict — an order
// item is a historical record; nothing may delete the variant it points
// to out from under it (same protective reasoning as Inventory->Location).

// Step 36: minimal order status lifecycle. pending -> fulfilled and
// pending -> cancelled are the only valid transitions (enforced in
// order-mutations.ts's updateOrderStatus(), not by the database) — both
// fulfilled and cancelled are terminal, with no transition back to pending
// and no transition between fulfilled and cancelled. No payment-related or
// shipping-related status values (paid, shipped, delivered, etc.) exist
// here — payment state and shipping state are separate concerns, not part
// of this lifecycle.
enum OrderStatus {
  pending
  fulfilled
  cancelled
}

// Step 32: minimal guest-checkout customer identity. NOT an authenticated
// account — no password, no session, no login. Identity is determined
// solely by (tenantId, email): the same email checking out again for the
// same tenant reuses this row (name/phone refreshed to the latest
// checkout values); email itself is the stable identity key and is never
// changed by the checkout flow. The same email may belong to different
// Customer rows across different tenants — this is not a cross-tenant
// identity, by design.
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("customers")
}

// Step 30: the customer's chosen payment method, captured at
// order-creation time. `cod` is the only functionally complete method —
// no external call is made, the order simply proceeds as `pending`.
// `momo` and `bank_transfer` are selectable and recorded now; real gateway
// integration (API calls, webhooks, payment confirmation) is explicitly
// out of scope for this step and belongs to a later one. No new
// OrderStatus values were added for this — payment confirmation, once it
// exists, is a status-lifecycle concern, not a schema field added here
// speculatively.
enum PaymentMethod {
  cod
  momo
  bank_transfer
}

model Order {
  id                 String        @id @default(uuid())
  tenantId           String
  customerId         String
  status             OrderStatus   @default(pending)
  paymentMethod      PaymentMethod
  // Step 34: a delivery-address SNAPSHOT captured at checkout time, the
  // same convention as OrderItem.price — stored directly on Order (not on
  // Customer, not a separate Address model, per the approved design), so
  // a customer's address on file (if ever built later) could change
  // without altering this order's historical delivery record. No
  // province/ward IDs, no postal code, no geocoding — plain text fields
  // only, V1 scope.
  shippingAddress    String
  shippingWard       String
  shippingDistrict   String
  shippingCity       String
  shippingNote       String?
  // V1 Configurable Shipping: both are SNAPSHOTS taken once at order
  // creation, the same convention as OrderItem.price above — never a live
  // read of TenantShippingMethod, so a merchant later renaming/repricing/
  // deleting a shipping method can never alter what an already-placed
  // order shows or was charged. shippingAmount defaults to 0 (not
  // nullable) so every historical pre-shipping order is correctly and
  // permanently "free shipping" rather than an ambiguous null state.
  // shippingMethodName is nullable only for those same historical orders
  // (which never had a method at all) — a new order always populates it.
  shippingAmount     Int           @default(0)
  shippingMethodName String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items    OrderItem[]
  // Step 51: a Payment row now exists for EVERY order regardless of
  // paymentMethod (cod/bank_transfer_manual included) — see PaymentProviderType
  // below. Still deliberately a separate model/status axis from
  // OrderStatus — payment succeeding or failing never changes Order.status.
  payment  Payment?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  tenantId         String
  orderId          String
  productVariantId String
  quantity         Int
  price            Int // snapshot of ProductVariant.price at order-creation time — never live, never re-read
  createdAt        DateTime @default(now())

  order          Order          @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

// Step 51 (Payment Architecture V2): deliberately a SEPARATE concept/
// status axis from OrderStatus (pending/fulfilled/cancelled) — payment
// succeeding or failing NEVER changes Order.status. One Payment per
// Order at most (1:1, enforced by @@unique on orderId) — now created for
// EVERY order regardless of method (see PaymentProviderType), not just
// momo as in the original Step 48 MVP.
enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  cancelled
}

// Which adapter actually handled this Payment — distinct from the
// customer-facing PaymentMethod above. A customer only ever sees/chooses
// "bank_transfer"; whether that's fulfilled by bank_transfer_manual or
// bank_transfer_sepay_va is a tenant-configuration detail (see
// TenantPaymentMethod) invisible to checkout logic.
enum PaymentProviderType {
  cod
  bank_transfer_manual
  bank_transfer_sepay_va
  momo
}

model Payment {
  id                    String              @id @default(uuid())
  tenantId              String
  orderId               String
  status                PaymentStatus       @default(pending)
  provider              PaymentProviderType
  // Provider-specific semantics (never renamed for naming-purity alone —
  // preserves the original Step 48 MoMo field, extended to other
  // providers rather than replaced):
  //   momo:                   our generated MoMo order reference (fresh,
  //                           unguessable per attempt) — MoMo's IPN
  //                           echoes this back as the correlation key.
  //   bank_transfer_sepay_va: our generated `order_code` sent to SePay
  //                           when creating the order/VA — SePay's
  //                           webhook `code` field echoes this back.
  //   cod / bank_transfer_manual: a fresh generated reference, never
  //                           sent to any external system, kept only so
  //                           every Payment has a stable unique handle.
  providerOrderId       String              @unique
  // momo: MoMo's transId. Other providers: informational only — the
  // AUTHORITATIVE dedupe key for webhook-driven providers lives on
  // PaymentEvent.providerEventId instead (see below), never here.
  providerTransactionId String?
  amount                Int // VND snapshot of the order total at initiation time
  // Set only for providers with a real expiration (SePay's VA); null for
  // cod/bank_transfer_manual/momo.
  expiresAt             DateTime?
  // Customer/merchant-facing reason when status = "failed" — e.g. "MoMo
  // payment is not configured on this server." Never a raw provider
  // error dump (no stack traces, no internal exception text).
  failureReason         String?
  // Provider-owned, adapter-specific data with no schema-level shape:
  // SePay's va_number/qr_code_url/order UUID, etc. Never sensitive
  // credentials — only per-payment public-ish data already returned to
  // the customer via PaymentInstructions.
  providerMetadata      Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order          @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  events PaymentEvent[]

  @@unique([orderId, tenantId])
  @@index([tenantId])
  @@map("payments")
}

// Step 51: webhook audit trail + the AUTHORITATIVE dedupe mechanism for
// any provider whose webhook can plausibly retry/replay (SePay, MoMo).
// Two independent layers of duplicate protection exist by design: this
// table's @@unique constraint (a true DB-level reject), plus the atomic
// guarded UPDATE ... WHERE status = 'pending' already used to transition
// Payment.status (a second, independent safety net — see
// payment-service.ts). Deliberately NOT an unbounded raw-log system:
// one row per genuine webhook delivery, nothing polled/generated
// speculatively.
model PaymentEvent {
  id              String              @id @default(uuid())
  paymentId       String
  provider        PaymentProviderType
  // The provider's own stable transaction identity, retained across
  // retries — NEVER a payment/order reference that could legitimately
  // repeat (e.g. SePay's `code`/order_code is NOT used here; SePay's
  // webhook `id`, its actual bank-transaction id, is). Null only for a
  // provider with no such id, which then falls back to relying solely on
  // the Payment.status guard for idempotency.
  providerEventId String?
  rawPayload      Json
  receivedAt      DateTime            @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// Step 51: per-tenant enablement + configuration for each customer-facing
// PaymentMethod. Closes a real gap in the original MVP: previously any
// tenant could have a customer select "momo" or "bank_transfer" with zero
// server-side check that the tenant had actually configured (or wanted)
// that method. `provider` picks which adapter backs a method when more
// than one exists for it (only bank_transfer today); `config` is
// provider-shaped JSON (manual: bank details; sepay_va: SePay bank
// account UUID) — never rendered back to the browser as raw JSON from
// Tenant Admin, only as a derived "configured"/"not configured" status.
model TenantPaymentMethod {
  id       String              @id @default(uuid())
  tenantId String
  method   PaymentMethod
  provider PaymentProviderType
  enabled  Boolean             @default(false)
  config   Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, method])
  @@map("tenant_payment_methods")
}

// V1 Configurable Shipping. Deliberately an open, tenant-authored LIST
// (create/rename/reprice/delete any number of methods) rather than a
// fixed-enum row-per-method shape like TenantPaymentMethod above —
// "payment method" is a closed set of integration types, "shipping
// method" is merchant-defined ("Standard", "Express", "Local Pickup").
// Flat-rate only for V1: `amount` is a plain VND integer, 0 = free/pickup
// (no separate free-shipping or pickup mechanism — see the doc comment on
// Order.shippingAmount/shippingMethodName for why Order never reads this
// model live). At most one row per tenant may have isDefault: true,
// enforced BOTH in application code (shipping-mutations.ts's
// clearOtherDefaults(), which handles the normal case cleanly) AND at the
// database level via a partial unique index (tenant_shipping_methods_one_default_per_tenant,
// added in the Shipping V1 migration — not visible in this model block,
// the same way Domain.isPrimary's own equivalent index,
// domains_one_primary_per_tenant, isn't visible on that model either;
// both are raw-SQL-only, this Prisma version has no declarative partial-
// index syntax). CORRECTION: an earlier version of this comment
// incorrectly claimed Domain.isPrimary has no such index — it does (see
// 20260824150052_init_tenant_foundation/migration.sql) — and
// TenantShippingMethod now follows that exact same precedent rather than
// deviating from it.
model TenantShippingMethod {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  amount    Int
  enabled   Boolean  @default(false)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_shipping_methods")
}
