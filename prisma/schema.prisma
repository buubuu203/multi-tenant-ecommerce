// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Tenant foundation -------------------------------------------------
// Scope: Tenant, Domain, Branding only. Commerce entities (Product, Order,
// Customer, etc.) are intentionally not modeled yet.

enum TenantStatus {
  pending
  active
  suspended
  archived
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  domains  Domain[]
  branding Branding?
  products Product[]

  @@map("tenants")
}

enum DomainType {
  subdomain
  custom
}

model Domain {
  id        String     @id @default(uuid())
  tenantId  String
  hostname  String     @unique
  type      DomainType
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("domains")
}

model Branding {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  storeName      String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("branding")
}

// --- Product foundation (Checkpoint 4C) ---------------------------------
// Foundation only: schema + tenant-scoped access + storefront read path.
// No CRUD UI yet (Checkpoint 4D). Deliberately minimal — see Notion
// Development Log, Checkpoint 4C, for what was excluded and why.

enum ProductStatus {
  draft
  active
}

model Product {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  price     Int // whole VND, no subunits — V1 market is Vietnam-only, no currency field yet
  status    ProductStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("products")
}
