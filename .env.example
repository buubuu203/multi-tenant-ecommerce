# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file with real secrets — .env* is already git-ignored.

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/ecom?schema=public"

# --- Auth (Clerk) ---
# Get these from your Clerk dashboard -> API Keys (use a Development instance for local work)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Platform domain config ---
# The base domain tenants use as a subdomain in development/testing,
# e.g. "yourplatform.com" -> shop-a.yourplatform.com
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN="localhost:3000"

# --- Payments: MoMo (platform-level, shared across all tenants) ---
# Get sandbox test credentials from developers.momo.vn — never Production
# credentials here. MoMo is simply "not configured" if any of these are
# unset (see src/lib/momo.ts's isMomoConfigured()), not a crash.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# --- Payments: SePay Order VA v2 (platform-level API token; each
# tenant's own bank-account UUID is configured per-tenant in Tenant
# Admin's Payments settings, not here) ---
# Sandbox base URL by default — set to https://userapi.sepay.vn/v2 only
# when actually promoting to Production.
SEPAY_API_BASE_URL="https://userapi-sandbox.sepay.vn/v2"
SEPAY_API_TOKEN=
# The webhook secret configured in your SePay dashboard for HMAC-SHA256
# webhook authentication — see src/lib/payments/sepay-va-provider.ts.
SEPAY_WEBHOOK_SECRET=
